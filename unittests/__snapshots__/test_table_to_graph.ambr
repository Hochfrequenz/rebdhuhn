  <text xml:space="preserve" text-anchor="start" x="779.21" y="-1545.6" font-family="Roboto, sans-serif" font-weight="bold" font-size="16.00">6.2.1 E_0401_Abmeldung pr&#252;fen</text>
  <!-- Start -->
